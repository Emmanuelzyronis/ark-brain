# Database — Neon Postgres (ark_brain database)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-HOST-pooler.c-10.us-east-1.aws.neon.tech/ark_brain?sslmode=require&channel_binding=require
DATABASE_URL_DIRECT=postgresql://neondb_owner:PASSWORD@ep-HOST.c-10.us-east-1.aws.neon.tech/ark_brain?sslmode=require

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-64-chars
JWT_EXPIRY=7d

# AI
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-6

# Azure AI (optional — for Azure-hosted Claude)
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_BASE_URL=

# OAuth — Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/oauth/slack/callback

# OAuth — GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/oauth/github/callback

# OAuth — Notion
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:3001/api/oauth/notion/callback

# OAuth — Confluence
CONFLUENCE_CLIENT_ID=
CONFLUENCE_CLIENT_SECRET=
CONFLUENCE_REDIRECT_URI=http://localhost:3001/api/oauth/confluence/callback

# OAuth — Google Drive
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REDIRECT_URI=http://localhost:3001/api/oauth/gdrive/callback

# Server
PORT=3001
FRONTEND_URL=http://localhost:3000
